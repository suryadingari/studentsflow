APP_NAME=AI Research and Outreach Framework
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name
LOG_LEVEL=INFO
ALLOWED_DOMAINS=
# Comma-separated exact origins. Development defaults to http://localhost:5173;
# set explicit HTTPS frontend origins when APP_ENV=production.
CORS_ALLOWED_ORIGINS=
# Optional Google Programmable Search. Without both values, explicit URL input remains available.
GOOGLE_CSE_API_KEY=replace-me
GOOGLE_CSE_SEARCH_ENGINE_ID=replace-me
# Email defaults to mock. Set to smtp and configure the values below only when live sending is intended.
EMAIL_PROVIDER=mock
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=research@example.com
SMTP_FROM_NAME=Research Team
AUTH_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
# Optional when the default user home directory is not writable:
# CRAWL4_AI_BASE_DIRECTORY=C:/path/to/writable/cache-root
